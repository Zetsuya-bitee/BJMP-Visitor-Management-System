{{> head}}
{{> navbar}}

<div class="flex flex-1">
  {{> sidebar}}

  <main class="flex-1 p-4 sm:p-6 lg:p-8 overflow-y-auto">
    {{> alerts}}

    <!-- Top Title and Action Bar -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <h2 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2">
          <i class="fa-solid fa-book-journal-whills text-amber-600"></i>
          Digital Visitor Logbook
        </h2>
        <p class="text-xs text-slate-500 mt-1">
          Official custody gate record replacing manual paper logs &bull; Permanent audit trail maintained
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <a href="/visitors/register" class="inline-flex items-center gap-2 px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-lg shadow-sm transition-colors">
          <i class="fa-solid fa-user-plus"></i>
          <span>New Visitor Registration</span>
        </a>
        <a href="/logbook/export/csv?{{#if filters.search}}search={{filters.search}}&{{/if}}{{#if filters.status}}status={{filters.status}}&{{/if}}{{#if filters.from_date}}from_date={{filters.from_date}}&{{/if}}{{#if filters.to_date}}to_date={{filters.to_date}}&{{/if}}" 
          class="inline-flex items-center gap-2 px-3 py-2 bg-slate-800 hover:bg-slate-700 text-white text-xs font-semibold rounded-lg shadow-sm transition-colors">
          <i class="fa-solid fa-file-csv text-emerald-400"></i>
          <span>Export CSV</span>
        </a>
      </div>
    </div>

    <!-- Active Count Warning Indicator -->
    {{#if (gt activeInsideCount 0)}}
    <div class="mb-4 bg-emerald-50 border border-emerald-300 rounded-lg p-3 text-xs text-emerald-900 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
        <span class="font-bold">{{ activeInsideCount }} Visitor(s) Currently Inside Facility</span>
        <span class="text-emerald-700 hidden sm:inline">&bull; Ensure gate checks are completed before visiting hours conclude.</span>
      </div>
      <a href="/logbook?status=Checked+In" class="font-bold underline text-emerald-800 hover:text-emerald-950">
        Filter Active Only &rarr;
      </a>
    </div>
    {{/if}}

    <!-- Search & Filter Controls -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4 mb-6">
      <form method="GET" action="/logbook" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
        
        <!-- Search Keyword -->
        <div class="lg:col-span-2">
          <label for="search" class="block text-[11px] font-bold text-slate-600 uppercase mb-1">
            Search Visitor / Inmate / Reference #
          </label>
          <div class="relative">
            <input type="text" id="search" name="search" value="{{ filters.search }}" placeholder="Type name, ID, or VRN-..."
              class="w-full text-xs pl-8 pr-3 py-2 bg-slate-50 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-sky-500">
            <div class="absolute inset-y-0 left-0 pl-2.5 flex items-center pointer-events-none text-slate-400">
              <i class="fa-solid fa-magnifying-glass text-xs"></i>
            </div>
          </div>
        </div>

        <!-- Status Filter -->
        <div>
          <label for="status" class="block text-[11px] font-bold text-slate-600 uppercase mb-1">Visit Status</label>
          <select id="status" name="status" class="w-full text-xs px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-sky-500">
            <option value="ALL" {{#if (eq filters.status 'ALL')}}selected{{/if}}>All Statuses</option>
            <option value="Checked In" {{#if (eq filters.status 'Checked In')}}selected{{/if}}>Checked In (Inside)</option>
            <option value="Checked Out" {{#if (eq filters.status 'Checked Out')}}selected{{/if}}>Checked Out (Completed)</option>
            <option value="Registered" {{#if (eq filters.status 'Registered')}}selected{{/if}}>Registered (Scheduled)</option>
            <option value="Denied" {{#if (eq filters.status 'Denied')}}selected{{/if}}>Denied Entry</option>
            <option value="Cancelled" {{#if (eq filters.status 'Cancelled')}}selected{{/if}}>Cancelled</option>
          </select>
        </div>

        <!-- Date Range: From -->
        <div>
          <label for="from_date" class="block text-[11px] font-bold text-slate-600 uppercase mb-1">From Date</label>
          <input type="date" id="from_date" name="from_date" value="{{ filters.from_date }}"
            class="w-full text-xs px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-sky-500">
        </div>

        <!-- Date Range: To -->
        <div>
          <label for="to_date" class="block text-[11px] font-bold text-slate-600 uppercase mb-1">To Date</label>
          <input type="date" id="to_date" name="to_date" value="{{ filters.to_date }}"
            class="w-full text-xs px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-sky-500">
        </div>

        <!-- Filter Actions Row -->
        <div class="sm:col-span-2 lg:col-span-5 flex items-center justify-between pt-2 border-t border-slate-100">
          <div class="flex items-center space-x-2">
            <label for="sort" class="text-xs text-slate-500 font-semibold">Sort Order:</label>
            <select id="sort" name="sort" class="text-xs bg-slate-50 border border-slate-300 rounded px-2 py-1">
              <option value="newest" {{#if (eq filters.sort 'newest')}}selected{{/if}}>Newest First</option>
              <option value="oldest" {{#if (eq filters.sort 'oldest')}}selected{{/if}}>Oldest First</option>
            </select>
          </div>

          <div class="flex items-center space-x-2">
            <a href="/logbook" class="px-3 py-1.5 border border-slate-300 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-50">
              Reset Filters
            </a>
            <button type="submit" class="px-4 py-1.5 bg-sky-600 hover:bg-sky-700 text-white rounded-lg text-xs font-bold shadow-sm">
              Apply Filters
            </button>
          </div>
        </div>

      </form>
    </div>

    <!-- Logbook Table Card -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
      
      <div class="px-5 py-3 border-b border-slate-200 bg-slate-50 flex items-center justify-between text-xs font-medium text-slate-500">
        <span>Showing <strong class="text-slate-800">{{ visits.length }}</strong> of <strong class="text-slate-800">{{ totalRecords }}</strong> Records</span>
        <span>Page <strong class="text-slate-800">{{ currentPage }}</strong> of <strong class="text-slate-800">{{ totalPages }}</strong></span>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200 text-xs text-left">
          <thead class="bg-slate-100 text-slate-600 uppercase tracking-wider font-semibold">
            <tr>
              <th scope="col" class="py-3 px-3">Reference No</th>
              <th scope="col" class="py-3 px-3">Visitor Name &amp; ID</th>
              <th scope="col" class="py-3 px-3">Inmate Visited</th>
              <th scope="col" class="py-3 px-3">Cell Location</th>
              <th scope="col" class="py-3 px-3">Date</th>
              <th scope="col" class="py-3 px-3">Time In / Out</th>
              <th scope="col" class="py-3 px-3">Status</th>
              <th scope="col" class="py-3 px-3">Officer</th>
              <th scope="col" class="py-3 px-3 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 text-slate-700">
            {{#if visits.length}}
              {{#each visits}}
              <tr class="hover:bg-slate-50 transition-colors">
                
                <!-- Ref No -->
                <td class="py-3 px-3 font-mono font-bold text-slate-900 whitespace-nowrap">
                  {{ this.reference_no }}
                </td>

                <!-- Visitor Name & ID -->
                <td class="py-3 px-3">
                  <div class="font-bold text-slate-900">{{ this.visitor.full_name }}</div>
                  <div class="text-[10px] text-slate-500">
                    {{ this.visitor.id_type }}: <span class="font-mono">{{ this.visitor.id_number }}</span>
                  </div>
                  <div class="text-[10px] text-slate-400">
                    Rel: <span class="font-medium text-slate-600">{{ this.relationship }}</span>
                  </div>
                </td>

                <!-- Inmate Visited -->
                <td class="py-3 px-3">
                  <div class="font-bold text-indigo-950">{{ this.inmate.last_name }}, {{ this.inmate.first_name }}</div>
                  <div class="text-[10px] text-slate-400 font-mono">{{ this.inmate.inmate_number }}</div>
                </td>

                <!-- Cell -->
                <td class="py-3 px-3 whitespace-nowrap">
                  <span class="inline-block px-2 py-0.5 bg-slate-100 rounded text-slate-800 font-semibold border border-slate-200 text-[11px]">
                    {{#if this.inmate.cell}}{{ this.inmate.cell.cell_number }}{{else}}Unassigned{{/if}}
                  </span>
                </td>

                <!-- Date -->
                <td class="py-3 px-3 whitespace-nowrap text-slate-600">
                  {{ this.visit_date }}
                </td>

                <!-- Time In / Out -->
                <td class="py-3 px-3 whitespace-nowrap">
                  <div><span class="text-slate-400">In:</span> <span class="font-bold text-slate-800">{{#if this.time_in}}{{ this.time_in }}{{else}}—{{/if}}</span></div>
                  <div><span class="text-slate-400">Out:</span> <span class="font-bold text-slate-800">{{#if this.time_out}}{{ this.time_out }}{{else}}—{{/if}}</span></div>
                </td>

                <!-- Status Badge -->
                <td class="py-3 px-3 whitespace-nowrap">
                  {{statusBadge this.status}}
                  {{#if this.denial_reason}}
                  <div class="text-[9px] text-red-600 truncate max-w-xs mt-0.5 font-medium" title="{{ this.denial_reason }}">
                    <i class="fa-solid fa-circle-info"></i> {{ this.denial_reason }}
                  </div>
                  {{/if}}
                </td>

                <!-- Processing Officer -->
                <td class="py-3 px-3 text-slate-600 whitespace-nowrap">
                  <div class="font-medium text-slate-800 truncate max-w-[120px]">
                    {{#if this.checkInOfficer}}{{ this.checkInOfficer.name }}{{else}}N/A{{/if}}
                  </div>
                  {{#if this.remarks}}
                  <div class="text-[10px] text-slate-400 truncate max-w-[120px]" title="{{ this.remarks }}">
                    Note: {{ this.remarks }}
                  </div>
                  {{/if}}
                </td>

                <!-- Actions -->
                <td class="py-3 px-3 text-right whitespace-nowrap space-x-1">
                  
                  <!-- Check-Out Action Button -->
                  {{#if (eq this.status 'Checked In')}}
                  <button type="button" onclick="openCheckoutModal('{{ this.id }}', '{{ this.reference_no }}', '{{ this.visitor.full_name }}')"
                    class="px-2.5 py-1 bg-blue-600 hover:bg-blue-700 text-white rounded font-bold text-[11px] shadow-sm">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i> Check Out
                  </button>
                  {{/if}}

                  <!-- Deny Action Button (Only if Registered or Checked In) -->
                  {{#if (or (eq this.status 'Checked In') (eq this.status 'Registered'))}}
                  <button type="button" onclick="openDenyModal('{{ this.id }}', '{{ this.reference_no }}', '{{ this.visitor.full_name }}')"
                    class="px-2 py-1 bg-red-100 hover:bg-red-200 text-red-700 border border-red-300 rounded font-semibold text-[11px]" title="Deny Visit">
                    <i class="fa-solid fa-ban"></i>
                  </button>
                  {{/if}}

                  <!-- Print Pass Button -->
                  <a href="/visitors/pass/{{ this.id }}" target="_blank"
                    class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-300 rounded font-semibold text-[11px]" title="Print Official Pass">
                    <i class="fa-solid fa-print"></i>
                  </a>

                  <!-- Edit / Correct Record Button -->
                  <button type="button" onclick="openEditModal({{json this}})"
                    class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-300 rounded font-semibold text-[11px]" title="Correct / Edit Record">
                    <i class="fa-solid fa-pen-to-square"></i>
                  </button>

                </td>

              </tr>
              {{/each}}
            {{else}}
              <tr>
                <td colspan="9" class="py-12 text-center text-slate-400 text-xs">
                  <i class="fa-solid fa-folder-open text-3xl mb-2 text-slate-300"></i>
                  <p>No visitor records match the selected filters.</p>
                </td>
              </tr>
            {{/if}}
          </tbody>
        </table>
      </div>

      <!-- Pagination Footer -->
      {{#if (gt totalPages 1)}}
      <div class="px-5 py-3 border-t border-slate-200 bg-slate-50 flex items-center justify-between text-xs">
        <div>
          Showing page {{ currentPage }} of {{ totalPages }}
        </div>
        <div class="flex space-x-1">
          {{#if (gt currentPage 1)}}
          <a href="/logbook?page={{sub currentPage 1}}&{{#if filters.search}}search={{filters.search}}&{{/if}}{{#if filters.status}}status={{filters.status}}&{{/if}}"
            class="px-3 py-1 bg-white border border-slate-300 rounded hover:bg-slate-100 font-semibold text-slate-700">
            &larr; Prev
          </a>
          {{/if}}

          {{#if (lt currentPage totalPages)}}
          <a href="/logbook?page={{add currentPage 1}}&{{#if filters.search}}search={{filters.search}}&{{/if}}{{#if filters.status}}status={{filters.status}}&{{/if}}"
            class="px-3 py-1 bg-white border border-slate-300 rounded hover:bg-slate-100 font-semibold text-slate-700">
            Next &rarr;
          </a>
          {{/if}}
        </div>
      </div>
      {{/if}}

    </div>

  </main>
</div>

<!-- ================= MODALS ================= -->

<!-- 1. Check-Out Modal -->
<div id="checkout-modal" class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-md w-full shadow-2xl border border-slate-200 overflow-hidden">
    <div class="bg-blue-600 text-white p-4 flex items-center justify-between">
      <h3 class="text-sm font-bold flex items-center gap-2">
        <i class="fa-solid fa-arrow-right-from-bracket"></i>
        Confirm Visitor Check-Out
      </h3>
      <button onclick="closeCheckoutModal()" class="text-blue-200 hover:text-white">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <form id="checkout-form" method="POST" action="">
      <div class="p-5 text-xs space-y-3">
        <p class="text-slate-700">
          You are processing the departure check-out for visitor <strong id="checkout-visitor-name" class="text-slate-900"></strong> (Ref: <code id="checkout-ref" class="font-mono font-bold"></code>).
        </p>
        <div>
          <label for="checkout-remarks" class="block font-bold text-slate-700 mb-1">Departure Notes / Property Return</label>
          <input type="text" id="checkout-remarks" name="remarks" placeholder="e.g. Visitor pass surrendered; locker key returned in good order."
            class="w-full text-xs px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
      </div>

      <div class="p-4 bg-slate-50 border-t border-slate-200 flex justify-end space-x-2">
        <button type="button" onclick="closeCheckoutModal()" class="px-4 py-2 border border-slate-300 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100">
          Cancel
        </button>
        <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-bold shadow-sm">
          Confirm Check-Out
        </button>
      </div>
    </form>
  </div>
</div>

<!-- 2. Deny Visit Modal -->
<div id="deny-modal" class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-md w-full shadow-2xl border border-slate-200 overflow-hidden">
    <div class="bg-red-600 text-white p-4 flex items-center justify-between">
      <h3 class="text-sm font-bold flex items-center gap-2">
        <i class="fa-solid fa-ban"></i>
        Deny Visitor Entry
      </h3>
      <button onclick="closeDenyModal()" class="text-red-200 hover:text-white">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <form id="deny-form" method="POST" action="">
      <div class="p-5 text-xs space-y-3">
        <p class="text-slate-700">
          Deny visitation for <strong id="deny-visitor-name" class="text-slate-900"></strong> (Ref: <code id="deny-ref" class="font-mono font-bold"></code>).
        </p>
        <div>
          <label for="denial_reason_modal" class="block font-bold text-red-700 mb-1">
            Mandatory Justification / Policy Reason <span class="text-red-500">*</span>
          </label>
          <textarea id="denial_reason_modal" name="denial_reason" rows="3" required
            placeholder="e.g. Possession of prohibited contraband / intoxication / visitor on active banned watchlist."
            class="w-full text-xs px-3 py-2 bg-red-50 border border-red-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 text-red-900"></textarea>
        </div>
      </div>

      <div class="p-4 bg-slate-50 border-t border-slate-200 flex justify-end space-x-2">
        <button type="button" onclick="closeDenyModal()" class="px-4 py-2 border border-slate-300 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100">
          Cancel
        </button>
        <button type="submit" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg text-xs font-bold shadow-sm">
          Confirm Denial
        </button>
      </div>
    </form>
  </div>
</div>

<!-- 3. Edit Record Modal (Controlled Correction with Audit Trail) -->
<div id="edit-modal" class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-lg w-full shadow-2xl border border-slate-200 overflow-hidden">
    <div class="bg-slate-900 text-white p-4 flex items-center justify-between">
      <h3 class="text-sm font-bold flex items-center gap-2">
        <i class="fa-solid fa-pen-to-square text-sky-400"></i>
        Controlled Record Correction &bull; Audit Trail Required
      </h3>
      <button onclick="closeEditModal()" class="text-slate-400 hover:text-white">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <form id="edit-form" method="POST" action="">
      <div class="p-5 text-xs space-y-3">
        <p class="text-slate-600">
          Editing Record <strong id="edit-ref" class="font-mono text-slate-900"></strong> &bull; Visitor: <strong id="edit-visitor-name"></strong>
        </p>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="edit-relationship" class="block font-bold text-slate-700 mb-1">Relationship</label>
            <input type="text" id="edit-relationship" name="relationship" required
              class="w-full text-xs px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-sky-500">
          </div>
          <div>
            <label for="edit-visiting-area" class="block font-bold text-slate-700 mb-1">Visiting Area</label>
            <input type="text" id="edit-visiting-area" name="visiting_area" required
              class="w-full text-xs px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-sky-500">
          </div>
        </div>

        <div>
          <label for="edit-purpose" class="block font-bold text-slate-700 mb-1">Purpose of Visit</label>
          <input type="text" id="edit-purpose" name="purpose" required
            class="w-full text-xs px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-sky-500">
        </div>

        <div class="bg-amber-50 border border-amber-300 rounded-lg p-3">
          <label for="edit-correction-reason" class="block font-bold text-amber-900 mb-1">
            Mandatory Correction Reason (Audit Compliance) <span class="text-red-500">*</span>
          </label>
          <textarea id="edit-correction-reason" name="correction_reason" rows="2" required
            placeholder="Explain why this record is being modified (e.g. Clerical error in visitor relationship classification per gate supervisor review)."
            class="w-full text-xs px-3 py-2 bg-white border border-amber-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500"></textarea>
        </div>

        <div>
          <label for="edit-remarks" class="block font-bold text-slate-700 mb-1">Additional Remarks</label>
          <input type="text" id="edit-remarks" name="remarks"
            class="w-full text-xs px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-sky-500">
        </div>

      </div>

      <div class="p-4 bg-slate-50 border-t border-slate-200 flex justify-end space-x-2">
        <button type="button" onclick="closeEditModal()" class="px-4 py-2 border border-slate-300 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100">
          Cancel
        </button>
        <button type="submit" class="px-4 py-2 bg-sky-600 hover:bg-sky-700 text-white rounded-lg text-xs font-bold shadow-sm">
          Save Correction &amp; Log Audit
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  // Checkout Modal
  function openCheckoutModal(id, ref, name) {
    document.getElementById('checkout-form').action = `/logbook/${id}/check-out`;
    document.getElementById('checkout-ref').textContent = ref;
    document.getElementById('checkout-visitor-name').textContent = name;
    document.getElementById('checkout-modal').classList.remove('hidden');
  }
  function closeCheckoutModal() {
    document.getElementById('checkout-modal').classList.add('hidden');
  }

  // Deny Modal
  function openDenyModal(id, ref, name) {
    document.getElementById('deny-form').action = `/logbook/${id}/deny`;
    document.getElementById('deny-ref').textContent = ref;
    document.getElementById('deny-visitor-name').textContent = name;
    document.getElementById('deny-modal').classList.remove('hidden');
  }
  function closeDenyModal() {
    document.getElementById('deny-modal').classList.add('hidden');
  }

  // Edit Modal
  function openEditModal(visit) {
    document.getElementById('edit-form').action = `/logbook/${visit.id}/edit`;
    document.getElementById('edit-ref').textContent = visit.reference_no;
    document.getElementById('edit-visitor-name').textContent = visit.visitor ? visit.visitor.full_name : '';
    document.getElementById('edit-relationship').value = visit.relationship || '';
    document.getElementById('edit-visiting-area').value = visit.visiting_area || '';
    document.getElementById('edit-purpose').value = visit.purpose || '';
    document.getElementById('edit-remarks').value = visit.remarks || '';
    document.getElementById('edit-correction-reason').value = '';
    document.getElementById('edit-modal').classList.remove('hidden');
  }
  function closeEditModal() {
    document.getElementById('edit-modal').classList.add('hidden');
  }
</script>

{{> footer}}

