<header class="bg-bjmp-navy border-b border-slate-700 text-white shadow-md sticky top-0 z-40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Logo and Facility Info -->
      <div class="flex items-center space-x-3">
        <button id="mobile-menu-btn" class="lg:hidden p-2 rounded-md text-slate-300 hover:text-white hover:bg-slate-800">
          <i class="fa-solid fa-bars text-xl"></i>
        </button>
        <div class="w-10 h-10 rounded-full bg-amber-500 text-slate-900 flex items-center justify-center font-black text-xl shadow-inner border border-amber-300">
          <i class="fa-solid fa-shield-halved"></i>
        </div>
        <div>
          <h1 class="text-base sm:text-lg font-bold tracking-tight text-white leading-tight flex items-center gap-2">
            BJMP CUSTODIAL MANAGEMENT SYSTEM
            <span class="hidden md:inline-block text-xs bg-amber-500/20 text-amber-300 border border-amber-500/40 px-2 py-0.5 rounded-full font-medium">GATE CONTROL UNIT</span>
          </h1>
          <p class="text-xs text-slate-400 hidden sm:block">Bureau of Jail Management and Penology &bull; Official Custodial Portal</p>
        </div>
      </div>

      <!-- Right Side: Officer Profile & Live Time -->
      <div class="flex items-center space-x-4">
        <!-- Live Clock -->
        <div class="hidden xl:flex items-center text-xs text-slate-300 bg-slate-800/80 px-3 py-1.5 rounded-lg border border-slate-700">
          <i class="fa-regular fa-clock text-amber-400 mr-2"></i>
          <span id="live-clock">Loading clock...</span>
        </div>

        {{#if currentUser}}
        <!-- Officer Badge & Menu -->
        <div class="flex items-center space-x-3 bg-slate-800/80 px-3 py-1.5 rounded-lg border border-slate-700">
          <div class="w-8 h-8 rounded-full bg-sky-700 flex items-center justify-center text-white font-semibold text-xs border border-sky-500">
            <i class="fa-solid fa-user-shield"></i>
          </div>
          <div class="text-left hidden sm:block">
            <div class="text-xs font-semibold text-slate-200">{{ currentUser.name }}</div>
            <div class="text-[10px] text-slate-400 flex items-center gap-1">
              <span class="uppercase tracking-wider font-bold text-amber-400">{{ currentUser.role }}</span>
              {{#if currentUser.badge_number}}
              <span>&bull; {{ currentUser.badge_number }}</span>
              {{/if}}
            </div>
          </div>
        </div>

        <!-- Logout Action -->
        <a href="/logout" class="inline-flex items-center justify-center px-3 py-1.5 rounded-md text-xs font-medium bg-red-600/90 hover:bg-red-700 text-white shadow-sm transition-colors duration-150" title="Secure Logout">
          <i class="fa-solid fa-arrow-right-from-bracket mr-1.5"></i>
          <span class="hidden sm:inline">Logout</span>
        </a>
        {{/if}}

      </div>
    </div>
  </div>
</header>

<script>
  function updateLiveClock() {
    const el = document.getElementById('live-clock');
    if (el) {
      const now = new Date();
      el.textContent = now.toLocaleDateString('en-US', {
        weekday: 'short',
        month: 'short',
        day: 'numeric',
        year: 'numeric'
      }) + ' ' + now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    }
  }
  updateLiveClock();
  setInterval(updateLiveClock, 1000);
</script>

